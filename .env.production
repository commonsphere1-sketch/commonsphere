# Build defaults for the deployed site. COMMITTED ON PURPOSE - the one .env file
# that is, by an exception in .gitignore.
#
# Vite reads this file on every production build (`vite build`), which is what
# Vercel runs, so the deployed site connects to Supabase without anything being
# set in Vercel. A variable set in Vercel's own settings still wins over this
# file. Local development does not read it: `npm run dev` uses .env.local.
#
# ONLY PUBLISHABLE VALUES BELONG HERE. Both of these are compiled into the
# JavaScript every visitor downloads, so they are public whether or not they are
# in the repository; what protects the data is row-level security in Supabase.
# Never put a service_role or sb_secret_ key in this file, or any other secret:
# it would be public the moment it is pushed. src/lib/supabase.ts refuses to
# start if it finds one in VITE_SUPABASE_ANON_KEY.
VITE_SUPABASE_URL=https://diplptvvvibnrrntyrap.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_ry_Iw89CENOP7H1-wg-YdQ_cU0dzQdk
