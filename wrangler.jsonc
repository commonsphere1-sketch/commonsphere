// Cloudflare Workers deploy config.
//
// The build (`npm run build`) writes a static site to ./dist; there is no
// Worker script, so this uploads that directory as static assets.
//
// "single-page-application" matters: routes such as /dashboard/rankings exist
// only in the React router, not as files in dist/. Without it, loading or
// refreshing any page but the root returns a 404 instead of index.html.
//
// "name" must match the Worker this repository is connected to in the
// Cloudflare dashboard (Workers & Pages → your project). Cloudflare defaults
// it to the repository name, which is what this is; change it if yours
// differs.
{
  "name": "commonsphere",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
