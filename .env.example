# Copy to .env.local and fill in. .env* is gitignored.

# US Census API key — optional, raises the anonymous rate limit for the
# state-level figures. https://api.census.gov/data/key_signup.html
#
# Note that api.census.gov sends no CORS header, so this is only useful once
# the request is made from a server or proxy rather than the browser.
VITE_CENSUS_API_KEY=

# ── Supabase ─────────────────────────────────────────────────────────────────
# Both are required for accounts (sign-in, and profile, notes, recordings and
# pins saved to the account). Without them the app runs without accounts and
# keeps everything in the browser. Set the same variables in Vercel (Project
# Settings → Environment Variables) for the deployed site.
#
# Project Settings → API in the Supabase dashboard.
VITE_SUPABASE_URL=https://diplptvvvibnrrntyrap.supabase.co
#
# The PUBLISHABLE (anon) key — never the service_role key. Anything with a
# VITE_ prefix is compiled into the bundle and served to every visitor, so a
# service_role key placed here would give each of them full read and write
# access to every table, past every RLS policy. src/lib/supabase.ts refuses to
# start if it detects one, but the real safeguard is not pasting it.
VITE_SUPABASE_ANON_KEY=

# Optional. OAuth providers to offer beside email sign-in, comma-separated:
# google, github, azure (Microsoft), apple. Each must also be switched on with
# its client id and secret under Authentication → Sign In / Providers in the
# Supabase dashboard; leave this empty until it is.
VITE_SUPABASE_OAUTH_PROVIDERS=
