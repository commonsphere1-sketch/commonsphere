# Copy to .env.local and fill in. .env* is gitignored.
#
# Supabase — optional. Without these the app runs exactly as before, with the
# profile kept in localStorage on each device. With them set, the profile is
# read from and written to the `profiles` table instead.
#
# Both values are on the Supabase dashboard under Project Settings → API.
# The anon key is the publishable one and is meant to ship in a browser bundle;
# it is not a secret. Do NOT put the service_role key here — that one bypasses
# row-level security and must never reach the client.
#
# Run supabase/schema.sql in the SQL editor before enabling these.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# US Census API key — optional, raises the anonymous rate limit for the
# state-level figures. https://api.census.gov/data/key_signup.html
VITE_CENSUS_API_KEY=
