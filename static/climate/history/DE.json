{"cc":"DE","defs":{"temp":{"label":"Mean temperature","unit":"degC","say":"the mean temperature of the year, averaged over the place"},"tempMax":{"label":"Mean daily high","unit":"degC","say":"the mean of each day's highest temperature in the year"},"tempMin":{"label":"Mean daily low","unit":"degC","say":"the mean of each day's lowest temperature in the year"},"precip":{"label":"Precipitation","unit":"mm","say":"rain and snow in the year, in millimetres of water"},"co2":{"label":"CO₂ emitted","unit":"mt","say":"carbon dioxide emitted from fossil fuels and industry in the year, in millions of tonnes"},"co2PerHead":{"label":"CO₂ per person","unit":"t","say":"carbon dioxide emitted from fossil fuels and industry in the year, in tonnes per person"},"hottestDay":{"label":"Hottest day","unit":"degC","say":"the year's highest daily temperature at each place, averaged over the country"},"coldestNight":{"label":"Coldest night","unit":"degC","say":"the year's lowest daily temperature at each place, averaged over the country"},"hotDays":{"label":"Days above 35 °C","unit":"days","say":"days in the year whose high passed 35 °C, at each place, averaged over the country"},"tropicalNights":{"label":"Nights above 20 °C","unit":"days","say":"nights in the year whose low stayed above 20 °C, at each place, averaged over the country"},"frostDays":{"label":"Frost days","unit":"days","say":"days in the year whose low fell below 0 °C, at each place, averaged over the country"},"wettestDay":{"label":"Wettest day","unit":"mm","say":"the year's most rain in one day at each place, averaged over the country"},"heavyRainDays":{"label":"Days of 20 mm or more","unit":"days","say":"days in the year with 20 mm of rain or more, at each place, averaged over the country"},"drySpell":{"label":"Longest dry spell","unit":"days","say":"the year's longest run of days with under 1 mm of rain, at each place, averaged over the country"},"quakeAlerts":{"label":"Earthquakes","unit":"count","say":"earthquakes GDA